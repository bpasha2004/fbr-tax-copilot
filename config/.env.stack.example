# Copy to .env.stack before starting Compose. Never commit the real file.
POSTGRES_DB=fbr_tax
POSTGRES_USER=fbr_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_KEY=replace-with-a-long-random-api-key
SECRET_KEY=replace-with-a-long-random-secret
JAZZCASH_WEBHOOK_SECRET=replace-with-sandbox-secret
EASYPAISA_WEBHOOK_SECRET=replace-with-sandbox-secret
RAAST_WEBHOOK_SECRET=replace-with-sandbox-secret
